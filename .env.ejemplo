# Lo más fácil: no lo copies a mano. Corré «python telegram/avisar.py --configurar» (Telegram)
# o «python apis/probar_api.py --configurar claude» (claves de API) y el .env se arma solo.
# Si preferís a mano: copiá este archivo con el nombre .env (sin «.ejemplo») y completalo en tu computadora.
# El .env NO se sube a GitHub: está en .gitignore. Este ejemplo sí se sube porque está vacío.
# Nunca pegues estos valores en un chat, en AGENTS.md ni en un mensaje.

# Token de tu bot de Telegram (te lo da @BotFather). Solo para telegram/avisar.py.
TELEGRAM_BOT_TOKEN=
# Tu número de chat de Telegram (lo completa --configurar; o mirá telegram/LEEME.md).
TELEGRAM_CHAT_ID=

# Claves de API: solo si un programa tuyo las necesita (mirá apis/LEEME.md). Con tu plan no hacen falta.
# Una clave por uso, con tope de gasto. Completá solo la que vayas a usar.
# Claude: platform.claude.com > API keys (al crearla, elegí un espacio de trabajo)
ANTHROPIC_API_KEY=
# Solo si tu clave de Claude quedó sin espacio de trabajo: el ID wrkspc_... de la página Workspaces.
ANTHROPIC_WORKSPACE_ID=
# OpenAI (ChatGPT): platform.openai.com > API keys
OPENAI_API_KEY=
# Gemini (Google): aistudio.google.com > API keys
GEMINI_API_KEY=

# El modelo que usa cada una en apis/probar_api.py: el más rápido y barato de cada empresa.
# Si una empresa le cambia el nombre, cambialo acá (mirá su lista de modelos).
MODELO_CLAUDE=claude-haiku-5-5
MODELO_OPENAI=gpt-6-luna
MODELO_GEMINI=gemini-4-hydrogen
