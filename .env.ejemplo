# Lo más fácil: no lo copies a mano. Corré «python telegram/avisar.py --configurar» y el .env se arma solo.
# Si preferís a mano: copiá este archivo con el nombre .env (sin «.ejemplo») y completalo en tu computadora.
# El .env NO se sube a GitHub: está en .gitignore. Este ejemplo sí se sube porque está vacío.
# Nunca pegues estos valores en un chat, en AGENTS.md ni en un mensaje.

# Token de tu bot de Telegram (te lo da @BotFather). Solo para telegram/avisar.py.
TELEGRAM_BOT_TOKEN=
# Tu número de chat de Telegram (lo completa --configurar; o mirá telegram/LEEME.md).
TELEGRAM_CHAT_ID=

# Clave de API, solo si un programa tuyo la necesita (capítulo de APIs). Con tu plan no hace falta.
# ANTHROPIC_API_KEY=
